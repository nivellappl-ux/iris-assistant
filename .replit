modules = ["nodejs-24", "rust-stable", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "IRIS LiveKit Agent"

[[workflows.workflow]]
name = "IRIS LiveKit Agent"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run agent:dev"

[workflows.workflow.metadata]
outputType = "console"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["pkg-config", "webkitgtk_4_1", "gtk3", "openssl", "librsvg", "dbus", "xorg.libX11", "xorg.libxcb", "xorg.libXi", "xorg.libXcursor", "xorg.libXrandr", "xorg.libXext", "libxkbcommon", "rustup", "zlib"]

[userenv]

[userenv.development]
AI_PROVIDER = "gemini"
LIVEKIT_URL = "wss://iris097-g89wn4vd.livekit.cloud/"

[userenv.shared]
VITE_GOOGLE_CLIENT_ID = "352860214095-eao50jtpeenh8hkm0i2dhi7ki1mc5g8k.apps.googleusercontent.com"
